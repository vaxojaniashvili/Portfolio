# ── Email (Resend) ──────────────────────────────────────────────
# 1. Create a free account at https://resend.com
# 2. Create an API key:  https://resend.com/api-keys
# 3. Copy this file to ".env.local" and fill in the values below.

# Your Resend API key (starts with "re_")
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered (your inbox)
MY_EMAIL=vaxojaniashvili186@gmail.com

# The "From" address shown on the email.
# For testing you can leave this unset — it defaults to onboarding@resend.dev.
# For production, verify a domain in Resend and use it here:
# EMAIL_FROM=Portfolio <contact@yourdomain.com>
EMAIL_FROM=
